{
    "name": "flagon",
    "version": "0.1.0",
    "private": true,
    "description": "Flagon — the self-hostable developer platform.",
    "license": "SEE LICENSE IN LICENSE",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev --concurrency=15",
        "dev:web": "turbo run dev --filter=@flagon/web",
        "dev:app": "turbo run dev --filter=@flagon/app",
        "dev:api": "turbo run dev --filter=@flagon/api",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "compose:up": "docker compose up -d",
        "compose:down": "docker compose down"
    },
    "devDependencies": {
        "prettier": "^3.8.1",
        "turbo": "^2.10.7",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "typescript": "^6.0.3",
        "sharp": "^0.35.3",
        "postcss": "^8.5.24"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "allowScripts": {
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.1": true,
        "@sentry/cli@2.58.6": true,
        "sharp@0.34.5": true,
        "unrs-resolver@1.12.2": true
    }
}
