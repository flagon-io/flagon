# Port the local Node server listens on.
PORT=3002

# Local Postgres (compose.yml at the repo root). One role, so it serves as both
# the app and owner connection locally; APP_DATABASE_URL / DATABASE_URL_UNPOOLED
# below are only needed in production.
DATABASE_URL=postgres://flagon:flagon@localhost:5432/flagon

# --- Production --------------------------------------------------------------
# Managed Postgres gives you the OWNER role's two connection strings:
#   DATABASE_URL           (owner, pooled)
#   DATABASE_URL_UNPOOLED  (owner, direct)  <- migrations use this automatically
# Keep those names as-is; they're the standard pooled/unpooled pair.
#
# The ONE secret you add by hand is the RLS-restricted app role (managed
# Postgres won't create it): its POOLED connection string, as APP_DATABASE_URL.
# The API prefers this over DATABASE_URL so runtime queries run as the
# restricted role and RLS is enforced. Convention for the role name: flagon_app.
# APP_DATABASE_URL=postgres://flagon_app:...@<pooled-host>/flagon?sslmode=require
#
# Optional override for the migration (owner) connection; defaults to
# DATABASE_URL_UNPOOLED, then DATABASE_URL.
# MIGRATE_DATABASE_URL=
