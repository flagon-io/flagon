# Port the local Node server listens on.
PORT=3002

# Sibling surfaces, for CORS and for resolving the session cookie ("browse the
# API while signed in"): the API asks the console's /api/auth/get-session to
# validate a forwarded cookie. Production: https://app.flagon.io / https://www.flagon.io
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Local Postgres (compose.yml at the repo root). One role, so it serves as both
# the app and owner connection locally; APP_DATABASE_URL / DATABASE_URL_UNPOOLED
# below are only needed in production.
DATABASE_URL=postgres://flagon:flagon@127.0.0.1:5432/flagon

# --- Production --------------------------------------------------------------
# Managed Postgres gives you the OWNER role's two connection strings:
#   DATABASE_URL           (owner, pooled)
#   DATABASE_URL_UNPOOLED  (owner, direct)  <- migrations use this automatically
# Keep those names as-is; they're the standard pooled/unpooled pair.
#
# The ONE secret you add by hand is the RLS-restricted app role (managed
# Postgres won't create it): its POOLED connection string, as APP_DATABASE_URL.
# The API prefers this over DATABASE_URL so runtime queries run as the
# restricted role and RLS is enforced. Convention for the role name: flagon_app.
# APP_DATABASE_URL=postgres://flagon_app:...@<pooled-host>/flagon?sslmode=require
#
# Optional override for the migration (owner) connection; defaults to
# DATABASE_URL_UNPOOLED, then DATABASE_URL.
# MIGRATE_DATABASE_URL=

# --- Error tracking (Sentry) -------------------------------------------------
# OFF until a DSN is set: unset, the API reports nothing and behaves exactly as
# before. Set the DSN to turn it on, no code change.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0   # 0 = errors only (no performance tracing)

# --- Billing (Stripe) --------------------------------------------------------
# OFF until STRIPE_SECRET_KEY is set. The API owns billing (checkout, portal,
# webhook, subscription sync). The Pro price is resolved at runtime from the
# lookup_key "pro_monthly" — create a $20/mo recurring price with that lookup
# key in Stripe; there is NO price id to configure here.
# STRIPE_SECRET_KEY=sk_test_...      (use a test key locally, live key in prod)
# The webhook signing secret. Locally, the compose `stripe` service prints it
# on startup (docker compose logs -f stripe) — stable per account, copy once.
# In prod, register https://api.flagon.io/webhooks/stripe and use its secret.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Auth (BetterAuth, hosted by the API) ------------------------------------
# REQUIRED. Signs every session cookie + token. In prod it MUST equal the value
# the console currently uses, or every existing session is invalidated on cutover.
# Locally it must match apps/app/.env.local so both engines validate one cookie.
BETTER_AUTH_SECRET=dev-secret-local-only-change-me-0123456789abcdef
# This API's own origin (used as BetterAuth baseURL). Defaults to the local port.
BETTER_AUTH_URL=http://localhost:3002
# Shared apex cookie across app./www./api. — set in prod, leave unset locally.
# AUTH_COOKIE_DOMAIN=.flagon.io
# Email now sends from the API (verification / reset / invites). Unset = console
# logger (fine locally; MUST be set in prod).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Flagon <robin@flagon.io>

# --- GitHub App (Projects connect a repo through it) -------------------------
# OFF until set. The API owns the integration (installation tokens, repo listing,
# webhook). Create a GitHub App: permissions Contents:Read + Metadata:Read;
# events installation + installation_repositories; "Request user authorization
# during installation" OFF. Two URLs on the app:
#   Setup URL    <APP_URL>/integrations/github/setup
#   Callback URL <APP_URL>/integrations/github/callback
# Webhook URL https://api.flagon.io/webhooks/github. See .notes/github-app-setup.md.
#
# Connecting proves the caller controls the installation via OAuth (install hop,
# then authorize hop -> exchange code -> GET /user/installations), so CLIENT_ID +
# CLIENT_SECRET are REQUIRED, and APP_URL (above) must be correct — the OAuth
# redirect_uri is built from it.
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=flagon            (the app's URL slug, for the install link)
# The private key PEM (generate + download in the App settings). May be pasted
# raw, with escaped \n, or base64-encoded (lib/github decodes any of these).
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_CLIENT_ID=Iv1....       (required — ownership-proof OAuth)
# GITHUB_APP_CLIENT_SECRET=...       (required — generate on the app)
# GITHUB_APP_WEBHOOK_SECRET=...      (matches the App's webhook secret)

# --- Secrets encryption ------------------------------------------------------
# Encrypts project environment-variable SECRETS at rest (AES-256-GCM). A 32-byte
# key, base64 or hex. Required only once secret env vars are used.
# SECRETS_ENCRYPTION_KEY=base64:...
