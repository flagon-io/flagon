{
  "name": "@flagon/api",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "stripe:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-stripe.ts",
    "stripe:reconcile": "node --env-file-if-exists=.env --import tsx scripts/reconcile-subscriptions.ts",
    "seed:usage": "node --env-file-if-exists=.env --import tsx scripts/seed-validation-usage.ts",
    "seed:experiments": "node --env-file-if-exists=.env --import tsx scripts/seed-experiments.ts",
    "purge:test-orgs": "node --env-file-if-exists=.env --import tsx scripts/purge-test-orgs.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@sentry/node": "^10.69.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "postgres": "^3.4.9",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openfeature/ofrep-provider": "^0.2.5",
    "@openfeature/server-sdk": "^1.23.0",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.7",
    "typescript": "^5"
  }
}
