{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:migrate && npm run stripe:sync && npm run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../package-lock.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/internal/cron/report", "schedule": "*/5 * * * *" },
    { "path": "/internal/cron/escalate", "schedule": "*/5 * * * *" },
    { "path": "/internal/cron/notify", "schedule": "* * * * *" },
    { "path": "/internal/cron/checks", "schedule": "* * * * *" }
  ]
}
