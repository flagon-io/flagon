# URL of the Flagon API (Hono). Docs code samples show this as the eval host.
# Local is the API dev server on :3002; production is https://api.flagon.io
NEXT_PUBLIC_API_URL=http://localhost:3002

# URL of the Flagon app / console (sign in, create SDK keys). Local is the app
# dev server on :3001; production is https://app.flagon.io
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Error tracking (Sentry) -------------------------------------------------
# OFF until a DSN is set: unset, the site reports nothing and builds exactly as
# before. Needed on both server and client, hence the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Source-map upload on build (optional; only runs when all three are set):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
