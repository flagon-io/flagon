-- The performance playbook: ingest. Record a deploy and bump the
-- project's counter, in one transaction. The timestamp is fixed (the day the
-- sample data ends) so every run of the lab sees the same data.
\set p random(1, 20000)
begin;
insert into events (account_id, project_id, user_id, kind, payload, created_at)
select account_id, id, owner_id, 'deploy', '{"status": "ok"}', timestamptz '2026-10-06 12:00'
from projects where id = :p;
update projects
   set event_count = event_count + 1, last_event_at = timestamptz '2026-10-06 12:00'
 where id = :p;
commit;
