{
    "$schema": "https://v2-10-8.turborepo.dev/schema.json",
    "globalDependencies": [
        "**/.env",
        "**/.env.*local"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "cache": false
        }
    }
}
