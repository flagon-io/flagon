# Used by compose.yml to configure the local Postgres dependency.
POSTGRES_USER=flagon
POSTGRES_PASSWORD=flagon
POSTGRES_DB=flagon
POSTGRES_PORT=5432

# Used by compose.yml for the local object storage (ministack) + its bucket
# bootstrap. Defaults are fine; the API's own STORAGE_* config lives in
# apps/api/.env (see apps/api/.env.example). Keep STORAGE_PUBLIC_BUCKET in sync
# with the API's STORAGE_PUBLIC_BUCKET.
STORAGE_PORT=4566
STORAGE_PUBLIC_BUCKET=flagon-public
